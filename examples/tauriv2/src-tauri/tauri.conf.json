{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "split-pane",
  "version": "0.1.0",
  "identifier": "dev.splitpane.example",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "split-pane / Tauri v2",
        "width": 1280,
        "height": 900,
        "backgroundColor": "#101117",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
